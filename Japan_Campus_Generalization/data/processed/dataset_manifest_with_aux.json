    "hot_water_kw"
  ],
  "calendar_columns": [
    "hour_sin",
    "hour_cos",
    "weekday_sin",
    "weekday_cos",
    "yearday_sin",
    "yearday_cos",
    "is_weekend"
  ],
  "auxiliary_data_policy": "Only historical weather and hot-water observations enter each input window; future observed values are never supplied.",
  "output": "data\\processed\\kitakyushu_2019_hourly_with_aux.csv"
