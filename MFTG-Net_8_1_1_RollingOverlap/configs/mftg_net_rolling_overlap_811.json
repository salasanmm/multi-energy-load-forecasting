{
  "model": "MFTG-Net",
  "experiment_tag": "dft_top5_811",
  "data": "data/dataset_input_jiuzheng.csv",
  "target_columns": ["KW", "CHWTON", "HTmmBTU"],
  "input_length": 168,
  "forecast_horizons": [24, 48, 72, 96],
  "split": {
    "method": "chronological",
    "train_ratio": 0.8,
    "validation_ratio": 0.1,
    "test_ratio": 0.1
  },
  "evaluation": {
    "protocol": "rolling_overlap_average",
    "cross_origin_averaging": true,
    "main_table_protocol": "rolling_overlap_average",
    "checkpoint_selection": "validation_mae",
    "test_used_for_selection": false
  },
  "training": {
    "seeds": [2020, 2021, 2022],
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "weight_decay": 0.00001,
    "batch_size": 256,
    "epochs": 60,
    "gradient_clip_norm": 5.0,
    "loss": "weighted_mape_plus_0.0005_weighted_mae"
  },
  "model_config": {
    "decomp_method": "dft_decomp",
    "top_k": 5,
    "d_model": 64,
    "e_layers": 3,
    "d_ff": 64,
    "moving_avg": 3,
    "down_sampling_window": 2,
    "down_sampling_layers": 2,
    "use_pgf": true,
    "use_crd": true,
    "use_ph": true,
    "use_anchor": true,
    "use_weekly_anchor": false,
    "use_haf": true,
    "overlap_consistency_smoothing": false
  }
}
